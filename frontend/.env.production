# Production build. There is no dev proxy here, so this must be the real origin
# the API is served from, including /api/v1.
#
# Set it wherever you build. On Vercel/Netlify/Cloudflare Pages this is an
# environment variable in the dashboard, not a committed value — leaving a real
# URL here would bake one host into the repo.
#
#   VITE_API_URL=https://your-backend.onrender.com/api/v1
VITE_API_URL=http://localhost:8000/api/v1
