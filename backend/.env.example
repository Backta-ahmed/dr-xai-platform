# Copy this file to .env and fill in real values.
# NEVER commit .env — it is gitignored for a reason.

# ── App ─────────────────────────────────────────────────
PROJECT_NAME="DR-XAI Platform"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# development | production
# Controls CORS strictness, debug behaviour, and whether seed.py will run.
ENVIRONMENT="development"

# ── Security ────────────────────────────────────────────
# REQUIRED. The app refuses to start without it — there is no default.
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=""

# Token lifetime in minutes. 60 = 1 hour.
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated list of origins allowed to call the API.
# Must NOT be "*" — wildcard plus credentials is both insecure and spec-invalid.
FRONTEND_ORIGINS="http://localhost:5173"

# ── Database ────────────────────────────────────────────
# REQUIRED. Supabase pooler connection string, or a local sqlite URL for dev:
#   sqlite+aiosqlite:///./dr_platform.db
DATABASE_URL=""

# ── Supabase storage ────────────────────────────────────
SUPABASE_URL=""
SUPABASE_KEY=""

# Private bucket for patient retinal images. Must NOT be public —
# these are PHI and are served only through the authenticated image route.
SUPABASE_BUCKET="retina-images"

# ── Model backend ───────────────────────────────────────
# stub    = simulated output, no model connected (current state)
# grading = real DR grading model (not yet trained)
#
# While this is "stub", every result is flagged is_simulated=True and the UI
# shows a "not for clinical use" banner. Do not change it until a real
# checkpoint is wired into GradingBackend.
MODEL_BACKEND="stub"

# ── Seeding ─────────────────────────────────────────────
# Used by seed.py to create the initial admin. Choose a strong password.
# seed.py refuses to run when ENVIRONMENT="production".
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD=""
